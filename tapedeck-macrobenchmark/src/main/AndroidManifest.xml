<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Merged into the benchmark (test) APK: the server listens on 127.0.0.1 and forwards to the real backend -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- No networkSecurityConfig here: androidx.benchmark's manifest sets one, and a conflict between two libraries can
         only be resolved by the consuming module. The test module must select @xml/tapedeck_network_security_config
         itself (see README, Quickstart). -->
</manifest>
